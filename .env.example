# Copy to apps/web/.env.local and adjust per environment.
# All values here are PUBLIC frontend configuration. Never put private keys in env files.

# Solana network target: devnet | localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint used by the frontend client
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed QuestBounty program address (see Anchor.toml [programs.*])
NEXT_PUBLIC_PROGRAM_ID=H49TxiF1wQBq58JRd2ztqDnZxcG9AGLrn6wiZvaWEngW
